rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'carsten.wesseling@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Freigegeben: Besitzer oder Mitglied mit Eintrag in editors/<mail> (Firestore).
    function isFreigegeben() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (request.auth.token.email == 'carsten.wesseling@gmail.com'
            || firestore.exists(/databases/(default)/documents/editors/$(request.auth.token.email)));
    }

    // Mitglied mit gültigem PIN-Zugang (Firestore: access/<uid> passt zu pins/<Name>, siehe firestore.rules).
    function isPinMember() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/access/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/pins/$(firestore.get(/databases/(default)/documents/access/$(request.auth.uid)).data.name)).data.pin
           == firestore.get(/databases/(default)/documents/access/$(request.auth.uid)).data.pin;
    }

    // Fotos der Kegeltouren: lesbar für Freigegebene und Mitglieder mit PIN-Zugang, schreibbar nur für den Besitzer.
    // Die Pfade sind zufällig, sie lassen sich nicht erraten, aber über den Link abrufen.
    match /touren/{file} {
      allow read: if isFreigegeben() || isPinMember();
      allow write: if isOwner() && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
